---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { locales, ui, type Locale } from '../../i18n';
import { getPosts } from '../../lib/posts';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];
const posts = await getPosts(lang);
const usedCategories = [...new Set(posts.map((p) => p.post.data.category))];
---

<Base lang={lang} path="/" alternatePath="/">
  <div class="container">
    <h1 class="visually-hidden">{t.siteTitle}</h1>
    <PostList lang={lang} posts={posts} usedCategories={usedCategories} featureFirst />
  </div>
</Base>

<style>
  .container {
    padding-top: var(--space-l);
  }
</style>
