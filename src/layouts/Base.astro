---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import { absoluteUrl, canonicalUrl, gamesUrls, href, mainSiteUrls, otherLocale, ui, type Locale } from '../i18n';
import Search from '../components/Search.astro';
import 'wust-ui/header.css';
import { header, iconButton, icons, themeScript } from 'wust-ui';

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  /** path of this page within its blog, e.g. /my-post/ */
  path: string;
  /** language of the page content; differs from lang when a post has no translation yet */
  contentLang?: Locale;
  /** canonical URL, defaults to this page */
  canonical?: string;
  /** where the language switch leads: the translated page, or the other blog's start page */
  alternatePath?: string | null;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { lang, title, description, path, contentLang = lang, canonical, alternatePath, image, type = 'website', publishedTime } = Astro.props;
const t = ui[lang];
const other = otherLocale(lang);
const pageTitle = title ? `${title} · ${t.siteTitle}` : t.siteTitle;
const pageDescription = description ?? t.siteDescription;
const canonicalHref = canonical ?? canonicalUrl(lang, path);
const switchHref = absoluteUrl(other, alternatePath ?? '/');
const ogImage = image ? new URL(image, canonicalUrl(lang)).toString() : undefined;

// the shared top bar of all wust.dev sites (github.com/TobiasWust/wust-ui)
const headerHtml = header({
  brand: { href: href(lang, '/'), logoSrc: '/tw.svg', label: 'blog', ariaLabel: t.home },
  links: [
    { href: mainSiteUrls[lang], label: t.mainSite },
    { href: gamesUrls[lang], label: t.games },
  ],
  lang,
  langHrefs: { de: lang === 'de' ? href('de', path) : switchHref, en: lang === 'en' ? href('en', path) : switchHref },
  langLabel: lang === 'de' ? 'This page in English' : 'Diese Seite auf Deutsch',
  themeLabel: t.toggleTheme,
  actions: iconButton({ label: `${t.search} (⌘K)`, icon: icons.search, attrs: 'data-search-open' }),
});
---

<!doctype html>
<html lang={contentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalHref} />
    {alternatePath !== null && alternatePath !== undefined && contentLang === lang && (
      <>
        <link rel="alternate" hreflang={lang} href={canonicalUrl(lang, path)} />
        <link rel="alternate" hreflang={other} href={canonicalUrl(other, alternatePath)} />
        {/* English is the default, like on wust.dev and games.wust.dev */}
        <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonicalUrl(lang, path) : canonicalUrl(other, alternatePath)} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title={t.siteTitle} href={href(lang, '/rss.xml')} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/icons/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0e1538" />
    <meta property="og:site_name" content={t.siteTitle} />
    <meta property="og:title" content={title ?? t.siteTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:locale" content={contentLang === 'de' ? 'de_DE' : 'en_US'} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="author" content="Tobias Wust" />
    <script is:inline set:html={themeScript} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <Fragment set:html={headerHtml} />

    <main id="main">
      <slot />
    </main>

    <footer class="footer" lang={lang}>
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} Tobias Wust</p>
        <nav aria-label="Footer">
          <a href={href(lang, '/rss.xml')}>{t.rss}</a>
          <a href={mainSiteUrls[lang]}>{t.mainSite}</a>
          <a href={gamesUrls[lang]}>{t.games}</a>
          <a href={`${mainSiteUrls[lang]}/imprint`}>{t.imprint}</a>
          <a href={`${mainSiteUrls[lang]}/privacy`}>{t.privacy}</a>
        </nav>
      </div>
    </footer>

    <Search lang={lang} />

    <script>
      import { initHeader } from 'wust-ui';
      initHeader();
    </script>

    <!-- cookie-free, anonymous page views; ignores localhost by default.
         blog.wust.dev and blog.tobiaswust.de share one site, so prefix the host to tell the languages apart -->
    <script is:inline>window.goatcounter = { path: function (p) { return location.host + p } }</script>
    <script is:inline data-goatcounter="https://blogwustdev.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed !important;
    top: 0.5rem; left: 0.5rem;
    width: auto; height: auto;
    clip-path: none;
    z-index: 200;
    padding: 0.5rem 1rem;
    background: var(--wu-orange);
    color: var(--wu-black);
  }

  .footer {
    margin-top: var(--space-xl);
    background: var(--footer-bg);
    color: var(--footer-text);
    font-size: var(--step--1);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: var(--space-l);
  }

  .footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .footer a { text-decoration: none; }
  .footer a:hover { color: var(--wu-orange); }
</style>
